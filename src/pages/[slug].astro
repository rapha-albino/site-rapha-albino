---
import BaseLayout from "../layouts/BaseLayout.astro";
import { posts, displayDate } from "../lib/blog";
export async function getStaticPaths() {
  return (await posts()).map((post) => ({ params: { slug: post.slug }, props: { post } }));
}
const { post } = Astro.props;
---
<BaseLayout title={`${post.title} — Raphael Albino`} description={post.title} activeSection="Blog"><article class="wrap article"><nav class="breadcrumb" aria-label="Navegação estrutural"><a href="/">Início</a><span aria-hidden="true">/</span><a href="/blog/">Blog</a></nav><p class="eyebrow">texto · <time datetime={post.publishedAt}>{displayDate(post.publishedAt)}</time></p><h1>{post.title}</h1><div class="article-content" set:html={post.html} /><p class="article-back"><a class="button alt" href="/blog/">← Voltar ao blog</a></p></article></BaseLayout>
