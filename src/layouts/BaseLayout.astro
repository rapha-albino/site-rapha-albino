---
import "../styles/global.css";
interface Props { title?: string; description?: string; activeSection?: string }
const { title = "Raphael Albino", description = "Autor, professor e consultor.", activeSection } = Astro.props;
const current = Astro.url.pathname;
const canonical = new URL(current, "https://rapha-albino.com.br");
const socialImage = new URL("/images/og-raphael-albino.jpg", canonical);
const links = [["Prática", "/pratica/"], ["Trajetória", "/trajetoria/"], ["Livros", "/escrita/"], ["Blog", "/blog/"], ["Conversas", "/conversas/"], ["Agora", "/agora/"], ["Contato", "/contato/"]];
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip" href="#conteudo">Pular para o conteúdo</a>
    <header><a class="brand" href="/">raphael albino<span>.</span></a><button class="menu-toggle" type="button" aria-expanded="false" aria-controls="menu-principal">Menu</button><nav id="menu-principal" aria-label="Principal">
      {links.map(([label, href]) => <a href={href} aria-current={current === href || activeSection === label ? "page" : undefined}>{label}</a>)}
    </nav></header>
    <main id="conteudo"><slot /></main>
    <footer><p>Raphael Albino, autor, professor e consultor.</p><p class="social-links"><a href="mailto:contato@rapha-albino.com.br"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M3 5h18v14H3zM3 7l9 6 9-6" /></svg>contato@rapha-albino.com.br</a><a href="https://www.linkedin.com/in/rapha-albino/"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M6 9v9M6 6v.01M10 18v-5a3 3 0 0 1 6 0v5M10 12v6" /></svg>LinkedIn</a><a href="https://www.instagram.com/rapha_albino/"><svg aria-hidden="true" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r=".8" fill="currentColor" stroke="none" /></svg>Instagram</a></p></footer>
    <script is:inline>
      const toggle = document.querySelector(".menu-toggle");
      const menu = document.querySelector("#menu-principal");
      toggle?.addEventListener("click", () => {
        const open = toggle.getAttribute("aria-expanded") === "true";
        toggle.setAttribute("aria-expanded", String(!open));
        menu?.toggleAttribute("data-open", !open);
      });
    </script>
  </body>
</html>
